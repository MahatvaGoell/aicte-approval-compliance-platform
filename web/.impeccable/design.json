  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink-filled action that presses like a counter stamp.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Record the decision <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;font:650 13px/1.2 Inter,system-ui,sans-serif;border-radius:6px;padding:9px 16px;min-height:40px;border:1px solid var(--control-line,#a8987f);background:var(--raised,#fffdf8);color:var(--ink,#1b1713);cursor:pointer;box-shadow:0 1px 0 rgba(27,23,19,.08);transition:translate .25s cubic-bezier(.16,1,.3,1),background .2s,border-color .2s,box-shadow .25s}.ds-btn:hover{border-color:var(--ink,#1b1713);translate:0 -1px;box-shadow:0 6px 14px -10px rgba(27,23,19,.6)}.ds-btn:active{translate:0 1px;box-shadow:none;transition-duration:.06s}.ds-btn:focus-visible{outline:2px solid var(--focus,#6b4f36);outline-offset:3px}.ds-btn svg{transition:translate .25s}.ds-btn:hover svg{translate:3px 0}.ds-btn-primary{background:var(--accent,#1b1713);color:var(--accent-ink,#fbf8f1);border-color:var(--accent,#1b1713)}.ds-btn-primary:hover{background:var(--accent-2,#3a3129);border-color:var(--accent-2,#3a3129)}"
    },
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button-default",
      "description": "Paper button with a control-edge stroke for secondary actions.",
      "html": "<button class=\"ds-btn-default\">Save draft</button>",
      "css": ".ds-btn-default{font:650 13px/1.2 Inter,system-ui,sans-serif;border-radius:6px;padding:9px 16px;min-height:40px;border:1px solid var(--control-line,#a8987f);background:var(--raised,#fffdf8);color:var(--ink,#1b1713);cursor:pointer;box-shadow:0 1px 0 rgba(27,23,19,.08);transition:translate .25s cubic-bezier(.16,1,.3,1),border-color .2s,box-shadow .25s}.ds-btn-default:hover{border-color:var(--ink,#1b1713);translate:0 -1px;box-shadow:0 6px 14px -10px rgba(27,23,19,.6)}.ds-btn-default:active{translate:0 1px;box-shadow:none}.ds-btn-default:focus-visible{outline:2px solid var(--focus,#6b4f36);outline-offset:3px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Fresh-sheet field; focus turns the edge to ink with a sepia halo.",
      "html": "<label class=\"ds-field\">Institution name<input class=\"ds-input\" placeholder=\"Demo College of Engineering\"></label>",
      "css": ".ds-field{display:grid;gap:6px;font:600 12.5px Inter,system-ui,sans-serif;color:var(--ink-2,#463d33)}.ds-input{font:400 14px Inter,system-ui,sans-serif;color:var(--ink,#1b1713);background:var(--raised,#fffdf8);border:1px solid var(--control-line,#a8987f);border-radius:5px;padding:9px 12px;min-height:40px;transition:border-color .2s,box-shadow .2s}.ds-input:hover{border-color:var(--ink-2,#463d33)}.ds-input:focus{outline:none;border-color:var(--ink,#1b1713);box-shadow:0 0 0 3px var(--stamp-soft,rgba(91,68,49,.09)),0 0 0 1px var(--ink,#1b1713)}.ds-input::placeholder{color:var(--muted,#685c4e)}"
    },
    {
      "name": "Status Chips",
      "kind": "chip",
      "refersTo": "chip-ok",
      "description": "Printed status labels: text always, dot and border style reinforce.",
      "html": "<span class=\"ds-chip ds-ok\">Approved</span> <span class=\"ds-chip ds-warn\">Awaiting response</span> <span class=\"ds-chip ds-bad\">Overdue</span> <span class=\"ds-chip ds-demo\">Demo rule</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:6px;padding:2px 8px;border-radius:4px;font:650 11.5px/1.5 Inter,system-ui,sans-serif;letter-spacing:.01em;border:1px solid color-mix(in srgb,currentColor 32%,transparent);color:var(--ink-2,#463d33)}.ds-chip::before{content:'';width:5px;height:5px;border-radius:50%;background:currentColor}.ds-ok{color:var(--ok,#4c3f31);background:var(--ok-soft,#e9e1d0)}.ds-warn{color:var(--stamp,#5b4431);border-style:dashed;border-color:color-mix(in srgb,currentColor 55%,transparent)}.ds-bad{color:var(--bad,#923a2c);background:var(--bad-soft,#f3e0d8);border-color:transparent}.ds-demo{color:var(--info,#5c5043);border-style:dotted}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Rail with the active item pulled out as a paper slip.",
      "html": "<nav class=\"ds-nav\"><div class=\"ds-nav-label\">Workspace</div><a href=\"#\">My work</a><a href=\"#\" class=\"on\">Applications</a><a href=\"#\">Documents</a><a href=\"#\">Dashboard</a></nav>",
      "css": ".ds-nav{display:grid;gap:2px;padding:14px;background:var(--rail,#ece5d6);width:220px;font:500 14px Inter,system-ui,sans-serif}.ds-nav-label{font:600 10.5px/1 Inter,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--muted,#685c4e);padding:0 12px 8px}.ds-nav a{padding:10px 12px;border-radius:6px;color:var(--ink-2,#463d33);text-decoration:none;transition:color .25s,background .25s}.ds-nav a:hover{color:var(--ink,#1b1713)}.ds-nav a:focus-visible{outline:2px solid var(--focus,#6b4f36);outline-offset:3px}.ds-nav a.on{color:var(--ink,#1b1713);font-weight:650;background:var(--raised,#fffdf8);box-shadow:0 1px 0 rgba(70,50,30,.05),0 12px 26px -20px rgba(70,48,26,.42),0 0 0 1px var(--line-2,#e7dfcf)}"
    },
    {
      "name": "Paper Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Resting sheet on the counter.",
      "html": "<section class=\"ds-card\"><h2>Checklist</h2><p>Six of eight items satisfied.</p></section>",
      "css": ".ds-card{background:var(--surface,#fbf8f1);border:1px solid var(--line,#d9cdb8);border-radius:8px;padding:24px;box-shadow:0 1px 0 rgba(70,50,30,.05),0 12px 26px -20px rgba(70,48,26,.42);color:var(--ink,#1b1713);font:400 14px/1.55 Inter,system-ui,sans-serif;transition:box-shadow .3s}.ds-card:hover{box-shadow:0 2px 0 rgba(70,50,30,.05),0 22px 40px -24px rgba(70,48,26,.5)}.ds-card h2{margin:0 0 4px;font:650 17px/1.15 Inter,sans-serif;letter-spacing:-.02em}.ds-card p{margin:0;color:var(--muted,#685c4e)}"
    },
    {
      "name": "Postmark",
      "kind": "custom",
      "refersTo": "rubber-stamp",
      "description": "Round dated postmark recording a completed stage or verification; lands with a 320ms stamp.",
      "html": "<span class=\"ds-postmark\"><svg viewBox=\"0 0 100 100\"><defs><path id=\"dsT\" d=\"M 12 50 A 38 38 0 0 1 88 50\"/><path id=\"dsB\" d=\"M 7 50 A 43 43 0 0 0 93 50\"/></defs><g fill=\"none\" stroke=\"currentColor\"><circle cx=\"50\" cy=\"50\" r=\"46\" stroke-width=\"3\"/><circle cx=\"50\" cy=\"50\" r=\"33\" stroke-width=\"1.4\"/><path d=\"M 17 40 H 83 M 17 60 H 83\" stroke-width=\"1.4\"/><text font-size=\"9.4\" font-weight=\"800\" letter-spacing=\"1\" stroke=\"none\" fill=\"currentColor\" text-anchor=\"middle\"><textPath href=\"#dsT\" startOffset=\"50%\">SCRUTINY</textPath></text><text font-size=\"7.8\" font-weight=\"700\" stroke=\"none\" fill=\"currentColor\" text-anchor=\"middle\"><textPath href=\"#dsB\" startOffset=\"50%\">STAGE 1</textPath></text><text x=\"50\" y=\"54.2\" font-size=\"11.2\" font-weight=\"800\" stroke=\"none\" fill=\"currentColor\" text-anchor=\"middle\">27 OCT 26</text></g></svg></span>",
      "css": ".ds-postmark{display:inline-block;width:76px;height:76px;color:var(--stamp,#5b4431);rotate:-6deg;font-family:'JetBrains Mono',ui-monospace,monospace;animation:ds-stamp 320ms cubic-bezier(.16,1,.3,1) both}.ds-postmark svg{width:100%;height:100%;overflow:visible}.ds-postmark:hover{rotate:-2deg;transition:rotate .3s}@keyframes ds-stamp{0%{opacity:0;scale:1.45;filter:blur(3px)}55%{opacity:1;scale:.94;filter:blur(0)}100%{opacity:1;scale:1}}@media (prefers-reduced-motion:reduce){.ds-postmark{animation:none}}"
    },
    {
      "name": "Urgency Clock",
      "kind": "custom",
      "refersTo": "delivery-note",
      "description": "Mono figure over the five-band ramp; the live band is ink, red when late.",
      "html": "<span class=\"ds-urg\"><b>10</b><span>days left</span><span class=\"ds-ramp\"><i><em>15+ d</em></i><i class=\"on\"><em>4–14</em></i><i><em>2–3</em></i><i><em>Today</em></i><i><em>Late</em></i></span></span>",
      "css": ".ds-urg{display:inline-grid;gap:2px;font:400 12px Inter,sans-serif;color:var(--muted,#685c4e)}.ds-urg b{font:650 30px/1 'JetBrains Mono',ui-monospace,monospace;letter-spacing:-.04em;color:var(--ink,#1b1713);font-variant-numeric:tabular-nums}.ds-ramp{display:grid;grid-template-columns:repeat(5,1fr);gap:3px;margin:8px 0 14px;min-width:170px}.ds-ramp i{position:relative;height:6px;border-radius:1px;background:var(--line-2,#e7dfcf);box-shadow:inset 0 0 0 1px var(--line,#d9cdb8)}.ds-ramp i em{position:absolute;top:9px;left:0;font:500 9.5px/1 'JetBrains Mono',monospace;font-style:normal;white-space:nowrap}.ds-ramp i.on{background:var(--ink,#1b1713);box-shadow:none}.ds-ramp i.on em{color:var(--ink,#1b1713);font-weight:700}"
    },
    {
      "name": "Sorting Rack Cubby",
      "kind": "custom",
      "refersTo": "cubby-late",
      "description": "Ruled pigeonholes with mono counts; a late cubby is hatched natural red.",
      "html": "<div class=\"ds-rack\"><a class=\"ds-cubby\" href=\"#\"><span>Due within 3 days</span><b>4</b></a><a class=\"ds-cubby late\" href=\"#\"><span>Overdue</span><b>2</b></a></div>",
      "css": ".ds-rack{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--line,#d9cdb8);border:1px solid var(--line,#d9cdb8);border-radius:8px;overflow:hidden;width:440px}.ds-cubby{display:grid;gap:16px;min-height:150px;padding:20px 22px 18px;background:var(--surface,#fbf8f1);color:var(--ink,#1b1713);text-decoration:none;font:600 13px Inter,sans-serif;transition:background .25s}.ds-cubby:hover{background:var(--raised,#fffdf8)}.ds-cubby:focus-visible{outline:2px solid var(--focus,#6b4f36);outline-offset:-3px}.ds-cubby b{align-self:end;font:650 46px/1 'JetBrains Mono',monospace;letter-spacing:-.05em}.ds-cubby.late{background-color:var(--bad-soft,#f3e0d8);background-image:repeating-linear-gradient(135deg,var(--hatch,rgba(146,58,44,.11)) 0 7px,transparent 7px 14px);color:var(--bad,#923a2c)}"
