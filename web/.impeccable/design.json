  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The principal action in a group.",
      "html": "<button class=\"ds-button-primary\">Save draft</button>",
      "css": ".ds-button-primary{font:600 13px var(--font);border-radius:10px;padding:10px 16px;min-height:40px;display:inline-flex;align-items:center;justify-content:center;gap:7px;cursor:pointer;transition:transform .35s var(--ease),background .3s var(--ease),border-color .3s var(--ease),box-shadow .35s var(--ease);background:var(--accent);color:var(--accent-ink);border:1px solid var(--accent)}.ds-button-primary:hover{transform:translateY(-1px);box-shadow:0 10px 24px -12px var(--accent)}.ds-button-primary:active{transform:scale(.97)}.ds-button-primary:focus-visible{outline:2px solid var(--focus);outline-offset:3px}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A supporting action with a visible neutral boundary.",
      "html": "<button class=\"ds-button-secondary\">Previous</button>",
      "css": ".ds-button-secondary{font:600 13px var(--font);border-radius:10px;padding:10px 16px;min-height:40px;display:inline-flex;align-items:center;justify-content:center;gap:7px;cursor:pointer;transition:transform .35s var(--ease),background .3s var(--ease),border-color .3s var(--ease),box-shadow .35s var(--ease);background:var(--surface);color:var(--ink);border:1px solid var(--control-line)}.ds-button-secondary:hover{transform:translateY(-1px);border-color:color-mix(in srgb,var(--ink) 28%,var(--line))}.ds-button-secondary:active{transform:scale(.97)}.ds-button-secondary:focus-visible{outline:2px solid var(--focus);outline-offset:3px}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "input",
      "description": "A labelled field with a strong control stroke.",
      "html": "<label class=\"ds-field\">Search<input placeholder=\"Application no. or institution\" /></label>",
      "css": ".ds-field{display:grid;gap:6px;font:600 12.5px var(--font);color:var(--ink-2)}.ds-field input{font:inherit;color:var(--ink);background:var(--raised);border:1px solid var(--control-line);border-radius:9px;padding:9px 12px;transition:border-color .25s var(--ease),box-shadow .25s var(--ease)}.ds-field input::placeholder{color:var(--muted);opacity:1}.ds-field input:hover{border-color:color-mix(in srgb,var(--ink) 22%,var(--line))}.ds-field input:focus-visible{outline:none;border-color:var(--accent);box-shadow:0 0 0 4px var(--accent-soft)}"
    },
    {
      "name": "Navigation item",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "Selected primary navigation.",
      "html": "<a class=\"ds-nav\" href=\"#\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M3 6.5A1.5 1.5 0 0 1 4.5 5H9l2 2.5h8.5A1.5 1.5 0 0 1 21 9v9.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5z\"/></svg>Applications</a>",
      "css": ".ds-nav{display:flex;align-items:center;gap:11px;padding:11px 12px;border-radius:var(--radius-sm);background:var(--accent-soft);color:var(--accent);text-decoration:none;font:600 14px var(--font);transition:color .3s var(--ease)}.ds-nav svg{width:17px;height:17px}.ds-nav:hover{color:var(--ink)}.ds-nav:focus-visible{outline:2px solid var(--focus);outline-offset:3px}"
    },
    {
      "name": "Status chip",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "Readable state, with colour as reinforcement.",
      "html": "<span class=\"ds-status\">In process</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:6px;padding:2px 9px;border-radius:999px;background:var(--accent-soft);color:var(--accent);font:600 11.5px/1.5 var(--font);letter-spacing:.01em}.ds-status::before{content:\"\";width:6px;height:6px;border-radius:50%;background:currentColor}"
    },
    {
      "name": "Shared card",
      "kind": "card",
      "refersTo": "card",
      "description": "A restrained neutral container.",
      "html": "<section class=\"ds-card\"><h2>Documents</h2><p>Upload, exact versions and human verification.</p></section>",
      "css": ".ds-card{padding:24px;background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);font:14px/1.55 var(--font);transition:border-color .4s var(--ease)}.ds-card h2{font-size:17px;line-height:1.15;margin:0 0 12px}.ds-card p{color:var(--muted);margin:0}.ds-card:hover{border-color:color-mix(in srgb,var(--ink) 16%,var(--line))}"
    },
    {
      "name": "Named disclosure",
      "kind": "custom",
      "refersTo": "disclosure",
      "description": "A secondary record group that opens in place.",
      "html": "<details class=\"ds-disclosure\"><summary><span><strong>Case history</strong><small>Stage attempts and the complete event record</small></span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"m8 10 4 4 4-4\"/></svg></summary><div>Existing record content appears here.</div></details>",
      "css": ".ds-disclosure{background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:var(--radius);font:14px/1.55 var(--font)}.ds-disclosure summary{display:flex;align-items:center;gap:14px;padding:20px 22px;list-style:none;cursor:pointer}.ds-disclosure summary::-webkit-details-marker{display:none}.ds-disclosure small{display:block;color:var(--muted);font-size:12.5px;margin-top:3px}.ds-disclosure svg{width:18px;height:18px;margin-left:auto;color:var(--muted);transition:rotate var(--motion-fast)}.ds-disclosure[open] svg{rotate:180deg}.ds-disclosure>div{padding:0 24px 24px}.ds-disclosure summary:hover{color:var(--accent)}.ds-disclosure summary:focus-visible{outline:2px solid var(--focus);outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "Old-money simplicity",
    "overview": "The user-pinned old-money direction is expressed through warm ivory surfaces, forest-green actions and restrained brass details. The interface stays operational: clear labels, low ornament and a small number of immediately visible choices.\n\nSupporting controls live in named disclosures and secondary navigation. Surface tone, borders and spacing establish hierarchy; the palette remains quiet in both themes. This replaces the earlier teal direction.",
    "keyCharacteristics": [
      "Warm neutrals with a restrained forest accent.",
      "Named groups expose secondary options without overwhelming the main task.",
      "Locally bundled sans-serif typography and text-labelled semantic status.",
      "Responsive controls, visible focus and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Quiet Accent Rule",
        "body": "Use the primary accent for actions and selection; brass remains a restrained detail rather than a competing action colour.",
        "section": "colors"
      },
      {
        "name": "The Text Before Colour Rule",
        "body": "Status and provenance retain readable labels; colour never supplies their only meaning.",
        "section": "colors"
      },
      {
        "name": "The Named Group Rule",
        "body": "Keep secondary options under a clear, descriptive group name rather than exposing every control at once.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do use the existing semantic tokens in both themes.",
      "Do keep labels, keyboard focus and text status visible.",
      "Do preserve forms and their state when placing them inside a disclosure.",
      "Do reserve strong visual emphasis for the current task and its action."
    ],
    "donts": [
      "Don't reintroduce the rejected teal palette.",
      "Don't add decorative metrics or imply an automatic regulatory decision.",
      "Don't create competing accent colours or expose every secondary option at once.",
      "Don't load remote fonts, scripts or images into the offline interface."
    ]
  }
}
