# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL. The embedded dev database (npm run db:start) listens on 54329.
DATABASE_URL=postgres://aicte:aicte_dev_password@127.0.0.1:54329/aicte
TEST_DATABASE_URL=postgres://aicte:aicte_dev_password@127.0.0.1:54329/aicte_test
PG_SUPERUSER_PASSWORD=aicte_dev_password

# API server
PORT=4000
APP_BASE_URL=http://localhost:5180
# Set true only behind HTTPS (marks session cookies Secure).
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Demo mode enables the labelled accelerated demo clock and demo credentials banner.
# It must be false in any real deployment; the clock offset is ignored when false.
DEMO_MODE=true

# Private document storage (local adapter). Kept outside any web root.
STORAGE_DIR=./var/storage
MAX_UPLOAD_MB=10

# Email: "outbox" writes .eml files to OUTBOX_DIR (no real delivery). "smtp" uses SMTP_URL.
EMAIL_ADAPTER=outbox
OUTBOX_DIR=./var/outbox
SMTP_URL=
EMAIL_FROM="AICTE Approval & Compliance Platform <no-reply@demo.aicte.test>"
# Simulated delivery failures for the demo adapter (comma separated domains).
EMAIL_TRANSIENT_FAILURE_DOMAINS=flaky.demo.test
EMAIL_PERMANENT_FAILURE_DOMAINS=bounce.demo.test

# Worker
WORKER_POLL_MS=1000
WORKER_CONCURRENCY=10

# Optional AI assistance. "none" keeps every feature deterministic.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Branding (configurable)
BRAND_NAME="AICTE Approval & Compliance Platform"
